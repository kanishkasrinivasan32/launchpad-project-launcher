# Preferred dashboard ports. launcher.bat selects free alternatives when occupied.
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
# Optional full path, e.g. C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=
AUTO_OPEN_BROWSER=true
STARTUP_TIMEOUT=30
MONITOR_INTERVAL=2
# Relative paths are resolved from the project root.
DATA_DIR=data
